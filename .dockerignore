# Dependencies & build output (installed/built fresh inside the image;
# critically, a host-copied node_modules here could contain
# Windows/macOS-specific native binaries, e.g. for sharp, that would break
# the Linux build if it leaked into the Docker context)
node_modules
.next
.pnpm-store

# Version control
.git
.gitignore

# Local/dev environment & secrets
.env
.env.*.local
test.env

# Persistent runtime data (mounted as volumes in production, not baked in)
/data
/media
*.db

# Editors / OS
.vscode
.idea
.DS_Store

# Tests & reports
/tests
/coverage
/test-results
/playwright-report
/blob-report

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
