DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Google OAuth (Sign in with Google) - from Google Cloud Console credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: override the callback URL Google redirects back to.
# Defaults to <request origin>/api/auth/google/callback.
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# SMTP (email notifications: registro de cliente, favoritos, confirmación de pedido)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=no-reply@triafana.com
SMTP_FROM_NAME=Triafana

# Wompi (pasarela de pagos) - https://comercios.wompi.co
# Llaves de "sandbox" (pub_test_/prv_test_) para pruebas, "production" (pub_prod_/prv_prod_) en vivo.
# Los métodos de pago disponibles en el widget (PSE, Nequi, Bancolombia) se activan
# desde el dashboard de Wompi, no desde código.
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxxxxxxxxxx
