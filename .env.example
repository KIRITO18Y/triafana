DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Google OAuth (Sign in with Google) - from Google Cloud Console credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: override the callback URL Google redirects back to.
# Defaults to <request origin>/api/auth/google/callback.
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# SMTP (email notifications: registro de cliente, favoritos, confirmación de pedido)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=no-reply@triafana.com
SMTP_FROM_NAME=Triafana
